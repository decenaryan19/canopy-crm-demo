# SQLite file, resolved relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Origin allowed to call POST /api/leads. "*" is fine for this demo.
# Set a real origin (or a comma-separated list) before exposing it publicly.
LEAD_INTAKE_ORIGIN="*"

# Auth token Twilio uses to sign call-status webhooks.
TWILIO_AUTH_TOKEN=""

# Local only. When "true", the webhook accepts unsigned requests.
# Leave unset anywhere the route is reachable from the public internet.
TWILIO_SKIP_SIGNATURE_CHECK="true"

# Optional. Use this when the app is behind a proxy and the incoming
# request URL is not the URL configured in the Twilio console.
# TWILIO_WEBHOOK_URL="https://example.com/api/twilio/call-status"
